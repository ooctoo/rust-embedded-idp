# Local no-tenant host example only. Copy with: ./examples/no-tenant-host/run.sh init
# This is sourced by Bash; quote values containing shell metacharacters.
EMBEDDED_IDP_APP_TENANCY_MODE=disabled
EMBEDDED_IDP_APP_PG_URI=postgres://127.0.0.1:5432/postgres
EMBEDDED_IDP_APP_PG_SCHEMA=no_tenant_host_idp
# Authorization namespace: must match the permissions and roles created in IdP.
NO_TENANT_HOST_BUSINESS_ID=reports
NO_TENANT_HOST_BUSINESS_SCHEMA=no_tenant_host_business
# Set this only when reports live in a different PostgreSQL database.
# NO_TENANT_HOST_BUSINESS_PG_URI=postgres://127.0.0.1:5432/report_business
EMBEDDED_IDP_APP_PG_TLS_MODE=disable
EMBEDDED_IDP_APP_SIGNING_KEY_FILE=examples/no-tenant-host/.local/idp-signing-key.der
EMBEDDED_IDP_APP_BIND_ADDR=127.0.0.1:9500
EMBEDDED_IDP_APP_ISSUER=http://127.0.0.1:9500
NO_TENANT_HOST_BIND_ADDR=127.0.0.1:9300
# NO_TENANT_HOST_BROWSER_ORIGIN=https://reports.example.test
EMBEDDED_IDP_APP_PUBLIC_CLIENT_ID=desktop-app
EMBEDDED_IDP_APP_PUBLIC_REDIRECT_URI=http://127.0.0.1:9300/
EMBEDDED_IDP_APP_LOGIN_POLICY=fixed
EMBEDDED_IDP_APP_LOGIN_TENANT_ID=0
EMBEDDED_IDP_APP_MANAGEMENT_LOGIN_POLICY=fixed
EMBEDDED_IDP_APP_MANAGEMENT_TENANT_ID=0
