# Isolated local example only. Never point fixture commands at a shared schema.
TENANT_HOST_PG_URI=postgres://postgres@127.0.0.1:5432/postgres
TENANT_HOST_PG_SCHEMA=a05_identity
TENANT_HOST_BUSINESS_SCHEMA=a05_reports
TENANT_HOST_BIND_ADDR=127.0.0.1:9400
TENANT_HOST_BROWSER_ORIGIN=http://127.0.0.1:9400
TENANT_HOST_ISSUER=http://localhost/tenant-host
TENANT_HOST_SIGNING_KEY_FILE=examples/tenant-host/.local/signing-key.der
TENANT_HOST_MANAGEMENT=true
