# Shared local configuration: loaded before .env.disabled or .env.enabled.
# scripts/dev_env.sh <mode> init creates .env if missing.
# Mode, schema, issuer and login policy belong in .env.<mode>.example.
# This file is sourced by Bash and follows shell assignment syntax.
# Values containing spaces or shell metacharacters must be quoted or escaped,
# especially passwords and secrets.
#
# Rule:
# - Parameters with code defaults are left commented out below.
# - Uncomment only the values you need to override locally.
# - Parameters without practical local defaults should be filled explicitly.

# ---------------------------------------------------------------------------
# Minimum setup for local standalone runs
# ---------------------------------------------------------------------------

# Required in practice for this module to connect to your Postgres instance.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
EMBEDDED_IDP_APP_PG_URI=postgres://127.0.0.1:5432/postgres

# Optional connection URI used only by the live Postgres checks.
# EMBEDDED_IDP_TEST_PG_CONNECTION_URI=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Base path for the standalone admin UI shell.
# Examples:
# - /      -> admin page is served at /
# - /admin -> admin page is served at /admin/
# Static assets are served under <base-path>/assets/*
# Standalone admin APIs remain under /api/admin/* and do not move with this base path.
# Default: /
# EMBEDDED_IDP_APP_ADMIN_UI_BASE_PATH=/

# Exact browser page origin; defaults to http://<bind address>. Non-loopback requires HTTPS.
# EMBEDDED_IDP_APP_BROWSER_ORIGIN=https://idp.example.test

# Shared RSA signing key used by both disabled and enabled local modes.
# Run `scripts/dev_env.sh disabled key-init` once before the first start;
# the generated owner-only PKCS#8 DER key is reused by either mode.
EMBEDDED_IDP_APP_SIGNING_KEY_FILE=.local/idp-signing-key.der

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------

# TLS mode for the postgres driver.
# Allowed values: disable | prefer | require
# Notes:
# - disable: always use plaintext transport
# - prefer: try plaintext-compatible behavior for local/dev
# - require: require TLS; combine with EMBEDDED_IDP_APP_PG_TLS_CA_CERT_PATH when needed
# Default: prefer
# EMBEDDED_IDP_APP_PG_TLS_MODE=disable

# Optional CA certificate path for Postgres TLS validation.
# Use this only when EMBEDDED_IDP_APP_PG_TLS_MODE=require and your server needs a custom CA.
# Example: /etc/ssl/certs/local-postgres-ca.pem
# No default
# EMBEDDED_IDP_APP_PG_TLS_CA_CERT_PATH=/path/to/ca-cert.pem

# Maximum connections in the shared IdP PostgreSQL pool.
# Each independent host process owns its own pool.
# Must be a positive integer.
# Default: 10
# EMBEDDED_IDP_APP_PG_MAX_CONNECTIONS=10

# Postgres connect timeout in seconds.
# Must be a positive integer.
# Default: 5
# EMBEDDED_IDP_APP_PG_CONNECT_TIMEOUT_SECS=5

# ---------------------------------------------------------------------------
# Auth and password policy
# ---------------------------------------------------------------------------

# Whether local self-service registration is enabled.
# Allowed values: true | false | 1 | 0 | yes | no
# Default: true
# EMBEDDED_IDP_APP_ALLOW_LOCAL_REGISTRATION=true

# Access token TTL in seconds.
# Default: 900
# EMBEDDED_IDP_APP_ACCESS_TOKEN_TTL_SECS=900

# Refresh token TTL in seconds.
# Default: 86400
# EMBEDDED_IDP_APP_REFRESH_TOKEN_TTL_SECS=86400

# Session TTL in seconds.
# Default: 604800
# EMBEDDED_IDP_APP_SESSION_TTL_SECS=604800

# Email verification code TTL in seconds.
# Used for /auth/register and /auth/resend-verification issued codes.
# Default: 900
# EMBEDDED_IDP_APP_VERIFICATION_CODE_TTL_SECS=900

# Minimum allowed password length.
# Default: 8
# EMBEDDED_IDP_APP_PASSWORD_MIN_LENGTH=8

# Maximum allowed password length.
# Default: 128
# EMBEDDED_IDP_APP_PASSWORD_MAX_LENGTH=128

# ---------------------------------------------------------------------------
# Verification email delivery
# ---------------------------------------------------------------------------

# How verification codes are delivered.
# log: print email/code to the app log; useful for local development.
# sendmail: invoke the local sendmail-compatible binary and write a plain-text email.
# smtp: send through a standard SMTP server; this is the recommended path for hosted mailbox providers.
# Allowed values: log | sendmail | smtp
# Default: log
# EMBEDDED_IDP_APP_EMAIL_DELIVERY_MODE=log

# Path to the sendmail-compatible binary used when EMAIL_DELIVERY_MODE=sendmail.
# Default: /usr/sbin/sendmail
# EMBEDDED_IDP_APP_EMAIL_SENDMAIL_COMMAND=/usr/sbin/sendmail

# From email address used for verification messages.
# Default: embedded-idp@localhost.localdomain
# EMBEDDED_IDP_APP_EMAIL_FROM=embedded-idp@example.com

# Optional display name for the From header.
# Default: unset
# EMBEDDED_IDP_APP_EMAIL_FROM_NAME='Embedded IDP'

# Subject line for verification emails.
# Default: Your embedded IDP verification code
# EMBEDDED_IDP_APP_EMAIL_VERIFICATION_SUBJECT='Your embedded IDP verification code'

# SMTP host used when EMAIL_DELIVERY_MODE=smtp.
# Examples:
# - smtp.gmail.com
# - smtp.office365.com
# - smtp.zoho.com
# - your company relay hostname
# Default: localhost
# EMBEDDED_IDP_APP_EMAIL_SMTP_HOST=smtp.gmail.com

# SMTP port used when EMAIL_DELIVERY_MODE=smtp.
# Common values:
# - 587 for STARTTLS
# - 465 for implicit TLS
# - 25 for plain/internal relay
# Default: 587
# EMBEDDED_IDP_APP_EMAIL_SMTP_PORT=587

# SMTP transport security mode.
# Allowed values:
# - starttls: plaintext connect then STARTTLS upgrade, most common for public mailbox providers
# - implicit_tls: TLS from connect time, often used with port 465
# - plain: no TLS, only for trusted internal relays
# Default: starttls
# EMBEDDED_IDP_APP_EMAIL_SMTP_TLS_MODE=starttls

# Optional SMTP username used when EMAIL_DELIVERY_MODE=smtp.
# For Gmail / Outlook / many hosted providers this is usually the full mailbox address.
# Leave unset only if your relay allows anonymous delivery from this host.
# No default
# EMBEDDED_IDP_APP_EMAIL_SMTP_USERNAME=your-mailbox@example.com

# Optional SMTP password or app password used when EMAIL_DELIVERY_MODE=smtp.
# For hosted providers you often need an app password or provider-issued SMTP credential,
# not your interactive login password.
# No default
# EMBEDDED_IDP_APP_EMAIL_SMTP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Device and OIDC timing
# ---------------------------------------------------------------------------

# Device nonce TTL in seconds.
# Default: 300
# EMBEDDED_IDP_APP_DEVICE_NONCE_TTL_SECS=300

# Allowed device proof clock skew in seconds.
# Default: 30
# EMBEDDED_IDP_APP_DEVICE_PROOF_CLOCK_SKEW_SECS=30

# Device heartbeat grace period in seconds.
# Default: 60
# EMBEDDED_IDP_APP_DEVICE_HEARTBEAT_GRACE_PERIOD_SECS=60

# Authorization code TTL in seconds.
# Default: 300
# EMBEDDED_IDP_APP_AUTHORIZATION_CODE_TTL_SECS=300

# Whether PKCE is required for public clients.
# Allowed values: true | false | 1 | 0 | yes | no
# Default: true
# EMBEDDED_IDP_APP_REQUIRE_PKCE_FOR_PUBLIC_CLIENTS=true

# ---------------------------------------------------------------------------
# Seeded public desktop client
# ---------------------------------------------------------------------------

# Public client id seeded at startup.
# Default: desktop-app
# EMBEDDED_IDP_APP_PUBLIC_CLIENT_ID=desktop-app

# Public client display name seeded at startup.
# Default: Embedded IdP Desktop App
# EMBEDDED_IDP_APP_PUBLIC_CLIENT_NAME='Embedded IdP Desktop App'

# Redirect URI seeded for the public desktop client.
# Must match the callback URI used by your local desktop or test app.
# Default: http://127.0.0.1:43821/callback
# EMBEDDED_IDP_APP_PUBLIC_REDIRECT_URI=http://127.0.0.1:43821/callback

# ---------------------------------------------------------------------------
# Optional seeded confidential client
# ---------------------------------------------------------------------------

# These values are optional.
# If you enable confidential client seeding, set both
# EMBEDDED_IDP_APP_CONFIDENTIAL_CLIENT_ID and
# EMBEDDED_IDP_APP_CONFIDENTIAL_CLIENT_SECRET together.

# Confidential client id seeded at startup.
# No default
# EMBEDDED_IDP_APP_CONFIDENTIAL_CLIENT_ID=web-app

# Confidential client display name.
# Default when confidential client is enabled: Embedded IdP Web App
# EMBEDDED_IDP_APP_CONFIDENTIAL_CLIENT_NAME='Embedded IdP Web App'

# Redirect URI for the confidential client.
# Default when confidential client is enabled: https://example.com/callback
# EMBEDDED_IDP_APP_CONFIDENTIAL_REDIRECT_URI=https://example.com/callback

# Raw client secret used only at seed time; the app stores its hash.
# No default
# EMBEDDED_IDP_APP_CONFIDENTIAL_CLIENT_SECRET=change-me

# Optional private-network HTTP development profile (requires explicit Cargo feature + debug).
# EMBEDDED_IDP_APP_HTTP_TRANSPORT_POLICY=development-private-network-http
# EMBEDDED_IDP_APP_DEVELOPMENT_SESSION_TTL_SECS=900
# EMBEDDED_IDP_APP_BROWSER_ORIGIN=http://192.168.31.159:9100
