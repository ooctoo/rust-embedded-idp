# Copy via: scripts/dev_env.sh enabled init
# Loaded after the shared .env; only mode-specific settings belong here.
EMBEDDED_IDP_APP_TENANCY_MODE=enabled
EMBEDDED_IDP_APP_BIND_ADDR=127.0.0.1:9200
EMBEDDED_IDP_APP_ISSUER=http://127.0.0.1:9200
EMBEDDED_IDP_APP_PG_SCHEMA=embedded_idp_enabled_v2
EMBEDDED_IDP_APP_PG_APP_NAME=idp-enabled-dev
EMBEDDED_IDP_APP_LOGIN_POLICY=choose
EMBEDDED_IDP_APP_MANAGEMENT_LOGIN_POLICY=fixed
EMBEDDED_IDP_APP_MANAGEMENT_TENANT_ID=0
# Set EMBEDDED_IDP_APP_LOGIN_TENANT_ID only when switching business login to fixed.
# Other optional settings: .env.example
