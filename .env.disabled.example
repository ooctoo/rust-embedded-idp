# Local reference host only; copy via: scripts/dev_env.sh disabled init
# Loaded after the shared .env; only mode-specific settings belong here.
EMBEDDED_IDP_APP_TENANCY_MODE=disabled
EMBEDDED_IDP_APP_BIND_ADDR=127.0.0.1:9100
EMBEDDED_IDP_APP_ISSUER=http://127.0.0.1:9100
EMBEDDED_IDP_APP_PG_SCHEMA=embedded_idp_disabled_v2
EMBEDDED_IDP_APP_PG_APP_NAME=idp-disabled-dev
EMBEDDED_IDP_APP_LOGIN_POLICY=fixed
EMBEDDED_IDP_APP_LOGIN_TENANT_ID=0
EMBEDDED_IDP_APP_MANAGEMENT_LOGIN_POLICY=fixed
EMBEDDED_IDP_APP_MANAGEMENT_TENANT_ID=0
